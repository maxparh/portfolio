:3000 {
  encode zstd gzip
  handle /api/* {
    reverse_proxy database:3000
  }
  handle {
    root * /srv
    @assets path /assets/*
    handle @assets {
      header Cache-Control "public, max-age=31536000, immutable"
      file_server
    }
    handle {
      try_files {path} /index.html
      header Cache-Control "no-cache"
      file_server
    }
  }
}
