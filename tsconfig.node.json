// TSConfig для конфигурационных файлов, исполняемых в Node.js.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["vite.config.*", "postcss.config.*"],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",

    // Только типы Node.js (без случайного включения других @types/*).
    "types": ["node"],

    // `vue-tsc --build` используется только для проверки типов.
    "noEmit": true,

    // .tsbuildinfo храним в node_modules, а не в корне проекта.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
