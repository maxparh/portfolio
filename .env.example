# Скопируйте файл в .env и заполните значениями:
#   cp .env.example .env
# .env не отслеживается Git и не попадает в Docker-образ.

# --- Публичные переменные клиентской сборки (Vite) ---
# Публичный site key Cloudflare Turnstile. Это НЕ секрет: он по дизайну
# попадает в клиентский бандл и доступен в браузере.
VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000000000000000PLACEHOLDER

# --- Параметры контейнера и прокси ---
# Порт на хосте, через который открывается сайт (docker compose).
SITE_PORT=80
# Для профиля tls: SITE_PORT=127.0.0.1:8080 (порт 80 занимает Caddy).
# Домен для автоматического HTTPS (профиль tls: docker compose --profile tls up -d).
# A/AAAA-запись домена должна указывать на IP сервера.
DOMAIN=maxparh.dev

# --- Секреты серверной стороны ---
# Никогда не используйте для них префикс VITE_: такие значения попадают в dist/.
# TELEGRAM_BOT_TOKEN — токен бота, выданный @BotFather
# TELEGRAM_CHAT_ID   — id чата/канала, куда бот отправляет заявки
# TURNSTILE_SECRET_KEY — secret key виджета Turnstile (Settings -> Secret Key)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TURNSTILE_SECRET_KEY=
