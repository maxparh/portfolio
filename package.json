{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Персональный сайт-портфолио: Vue 3 + TypeScript + Vite, Node.js-сервер для VPS",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run type-check && vite build",
    "build:app": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "serve": "npm run build:app && npm run build:server && npm start",
    "type-check": "vue-tsc --build && tsc -p tsconfig.functions.json && tsc -p tsconfig.server.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run type-check && npm test && vite build",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.9.0",
    "postcss": "^8.5.8",
    "prettier": "3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
